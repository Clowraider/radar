# Source database: existing TRH DB
TRH_DB_HOST=127.0.0.1
TRH_DB_PORT=5432
TRH_DB_NAME=trh
TRH_DB_USER=postgres
TRH_DB_PASSWORD=ponetuclave

# Destination database: new Radar TRH DB
RADAR_DB_HOST=127.0.0.1
RADAR_DB_PORT=5432
RADAR_DB_NAME=radar_trh
RADAR_DB_USER=postgres
RADAR_DB_PASSWORD=ponetuclave

# Sync behavior
# First run can use: python scripts/sync_trh_raw_to_radar.py --full
# Cron runs should use incremental mode with a lookback window.
RADAR_SYNC_BATCH_SIZE=1000
RADAR_SYNC_LOOKBACK_HOURS=48
