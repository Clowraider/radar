# Configuración de ejecución para Radar web.
# Copiar a `radar-web.env` y editar los valores reales.
# No subir `radar-web.env` al repo.

# Podés usar DATABASE_URL o las variables RADAR_DB_*.
# Si usás DATABASE_URL, podés dejar comentadas las variables RADAR_DB_*.

# DATABASE_URL=postgresql://radar_user:change-me@127.0.0.1:5432/radar_trh

# Host/IP donde está PostgreSQL.
# Si PostgreSQL corre en el mismo LXC, suele ser 127.0.0.1.
RADAR_DB_HOST=127.0.0.1

# Puerto de PostgreSQL.
RADAR_DB_PORT=5432

# Nombre de la base Radar.
RADAR_DB_NAME=radar_trh

# Usuario PostgreSQL para la web. Idealmente solo lectura.
RADAR_DB_USER=radar_user

# Clave del usuario anterior.
RADAR_DB_PASSWORD=change-me

# Máximo de conexiones de la app hacia PostgreSQL.
RADAR_DB_POOL_MAX=10

# IP donde escucha la app web dentro del LXC.
# 0.0.0.0 permite entrar desde fuera del contenedor si la red/firewall lo permite.
HOST=0.0.0.0

# Puerto HTTP de la app Radar.
PORT=3000
